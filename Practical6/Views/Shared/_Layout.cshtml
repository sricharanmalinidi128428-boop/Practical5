<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6f5" />
    <title>@ViewData["Title"] · Practical 6</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Products" asp-action="Index"><span class="brand-icon">P</span><span>Practical <strong>06</strong></span></a>
        <nav aria-label="Main navigation"><a class="active" asp-controller="Products" asp-action="Index">Products</a></nav>
        <span class="header-caption">ASP.NET MVC · Product Catalog</span>
    </header>
    @RenderBody()
    <footer class="site-footer"><span>Practical 6 · .NET Technologies</span><span>Models · Controllers · Views · Routing</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

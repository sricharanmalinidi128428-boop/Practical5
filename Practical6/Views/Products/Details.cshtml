@model Practical6Catalog.Models.Product
@{
    ViewData["Title"] = Model.Name;
}
<main class="page-shell details-shell">
    <a class="back-link" asp-controller="Products" asp-action="Index">← Back to product catalog</a>
    <article class="details-card">
        <img class="details-photo" src="~/images/products/@Model.ImageFile" alt="@Model.Name" />
        <div class="details-copy">
            <p class="eyebrow">PRODUCT DETAILS · #@Model.Id</p>
            <h1>@Model.Name</h1>
            <span class="category-pill">@Model.Category</span>
            <p class="details-description">@Model.Description</p>
            <div class="details-price"><span>Price</span><strong>₹@Model.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</strong></div>
            <a class="button button-primary" asp-controller="Products" asp-action="Index">Back to catalog</a>
        </div>
    </article>
</main>
